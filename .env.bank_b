# ===================== CashSync: BANK SERVER B =====================
# Start the server:     php artisan serve --port=8002 --env=bank_b
# Start its heartbeat:  php artisan cashsync:heartbeat --env=bank_b

APP_NAME="CashSync Bank B"
APP_ENV=bank_b
# Paste the APP_KEY from your .env file here:
APP_KEY=base64:y3HuFM39KGG67epTXNlZq+4sR9Wwx3OlV4IE24ZbH2M=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
APP_TIMEZONE=Africa/Kampala

# ---- CashSync ----
# This copy is bank server B, which starts as the BACKUP
CASHSYNC_MODE=bank
CASHSYNC_NODE=B
CASHSYNC_START_ROLE=backup
CASHSYNC_SELF_URL=http://127.0.0.1:8002
# The other bank server (A)
CASHSYNC_PEER_URL=http://127.0.0.1:8001
CASHSYNC_DAILY_LIMIT=5000000
CASHSYNC_DISABLE_LOCKS=false
CASHSYNC_ADMIN_KEY=cashsync-demo-key

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Bank B has its OWN database (a separate copy of the data)
DB_DATABASE=cashsync_b
DB_USERNAME=root
DB_PASSWORD=

# ---- Laravel housekeeping ----
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=info
BCRYPT_ROUNDS=10
MAIL_MAILER=log
# Allow 15 missed heartbeats before failover (for load tests on Windows)
CASHSYNC_HEARTBEAT_MISSES=3