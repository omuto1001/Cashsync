# ===================== CashSync: BANK SERVER A =====================
# Start the server:     php artisan serve --port=8001 --env=bank_a
# Start its heartbeat:  php artisan cashsync:heartbeat --env=bank_a

APP_NAME="CashSync Bank A"
# APP_ENV must match the file name (.env.bank_a -> bank_a)
APP_ENV=bank_a
# Paste the APP_KEY from your .env file here:
APP_KEY=base64:y3HuFM39KGG67epTXNlZq+4sR9Wwx3OlV4IE24ZbH2M=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_TIMEZONE=Africa/Kampala

# ---- CashSync ----
# This copy is a bank server called A, which starts as the PRIMARY
CASHSYNC_MODE=bank
CASHSYNC_NODE=A
CASHSYNC_START_ROLE=primary
CASHSYNC_SELF_URL=http://127.0.0.1:8001
# The other bank server (B)
CASHSYNC_PEER_URL=http://127.0.0.1:8002
CASHSYNC_DAILY_LIMIT=5000000
# Keep false! Only set true for the race-condition demo
CASHSYNC_DISABLE_LOCKS=false
CASHSYNC_ADMIN_KEY=cashsync-demo-key

# ---- MySQL (XAMPP default: user root, no password) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Bank A has its OWN database
DB_DATABASE=cashsync_a
DB_USERNAME=root
DB_PASSWORD=

# ---- Laravel housekeeping (store sessions and cache in files) ----
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=info
BCRYPT_ROUNDS=10
MAIL_MAILER=log
# Allow 15 missed heartbeats before failover (for load tests on Windows)
CASHSYNC_HEARTBEAT_MISSES=3