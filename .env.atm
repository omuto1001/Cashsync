# ===================== CashSync: ATM APP =====================
# Start the ATM:  php artisan serve --port=8000 --env=atm
# Then open http://127.0.0.1:8000 in the browser

APP_NAME="CashSync ATM"
APP_ENV=atm
# Paste the APP_KEY from your .env file here:
APP_KEY=base64:y3HuFM39KGG67epTXNlZq+4sR9Wwx3OlV4IE24ZbH2M=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Kampala

# ---- CashSync ----
# This copy is the ATM app
CASHSYNC_MODE=atm
# The bank servers, primary first, separated by a comma (no spaces)
CASHSYNC_BANK_SERVERS=http://127.0.0.1:8001,http://127.0.0.1:8002
# Wait at most 2 seconds for a reply before retrying
CASHSYNC_ATM_TIMEOUT=2
CASHSYNC_ADMIN_KEY=cashsync-demo-key

# ---- The ATM has NO database of its own: everything is asked from the bank ----
DB_CONNECTION=sqlite

# ---- Laravel housekeeping ----
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=info
MAIL_MAILER=log